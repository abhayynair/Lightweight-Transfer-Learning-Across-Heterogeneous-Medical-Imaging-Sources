    pick = lambda ids: df[df['lesion_id'].isin(ids['lesion_id'])]
    return (pick(l_tr), pick(l_va), pick(l_te),
            set(l_tr['lesion_id']), set(l_va['lesion_id']), set(l_te['lesion_id']))

