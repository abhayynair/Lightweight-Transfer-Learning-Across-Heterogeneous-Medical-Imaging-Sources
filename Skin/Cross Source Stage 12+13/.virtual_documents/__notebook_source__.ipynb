# ===== STEP 1: macro-AUC for all existing Stage 11 single-source models, vs pooled per-source AUC =====
from tensorflow.keras.applications.efficientnet import preprocess_input as eff_pre
from tensorflow.keras.applications.mobilenet_v2 import preprocess_input as mob_pre
from tensorflow.keras.applications.resnet50 import preprocess_input as res_pre
from sklearn.metrics import roc_auc_score
import gc

# locate whatever single-source checkpoints actually exist right now
print("Searching for all ss_*.keras checkpoints...")
found = os.popen("find /kaggle/input -iname 'ss_*.keras' 2>/dev/null").read().strip().split('\n')
found = [f for f in found if f]
for f in found:
    print(" ", f)

PREP_MAP = {'custom': None, 'mob': mob_pre, 'eff': eff_pre, 'res': res_pre}
SPLIT_MAP = {'isic': i_te, 'ham': h_te}

# already-known pooled-model, per-source macro-AUC, from stage8_per_source.csv (for comparison)
POOLED_AUC = {
    ('custom', 'isic'): 0.697607, ('custom', 'ham'): 0.848610,
    ('mob', 'isic'):    0.875058, ('mob', 'ham'):    0.928357,
    ('eff', 'isic'):    0.902703, ('eff', 'ham'):    0.946823,
    ('res', 'isic'):    0.881361, ('res', 'ham'):    0.948042,
}

results = []
for path in found:
    fname = os.path.basename(path).replace('.keras', '')
    parts = fname.split('_')
    if len(parts) < 3 or parts[0] != 'ss':
        continue
    arch, source = parts[1], parts[2]
    if arch not in PREP_MAP or source not in SPLIT_MAP:
        continue

    test_split = SPLIT_MAP[source]
    prep_fn = PREP_MAP[arch]
    eval_idg = ImageDataGenerator(rescale=1./255) if prep_fn is None else ImageDataGenerator(preprocessing_function=prep_fn)
    te_gen = eval_idg.flow_from_dataframe(
        test_split, x_col='image_path', y_col='label', target_size=(IMG_SIZE, IMG_SIZE),
        batch_size=BATCH_SIZE, class_mode='categorical', classes=FINAL_CLASSES, shuffle=False
    )
    m = load_model(path)
    y_true = np.asarray(te_gen.classes)
    y_prob = m.predict(te_gen, verbose=0)
    single_source_auc = roc_auc_score(np.eye(NUM_CLASSES)[y_true], y_prob, average='macro', multi_class='ovr')

    pooled_auc = POOLED_AUC.get((arch, source))
    gap = pooled_auc - single_source_auc if pooled_auc is not None else None

    results.append(dict(arch=arch, source=source, single_source_auc=single_source_auc,
                          pooled_auc=pooled_auc, gap=gap))
    print(f"{arch:8} {source:6}  single-source AUC: {single_source_auc:.4f}  "
          f"pooled AUC: {pooled_auc:.4f}  gap: {gap:+.4f}")

    del m; gc.collect(); tf.keras.backend.clear_session()

results_df = pd.DataFrame(results).sort_values(['arch', 'source'])
results_df.to_csv('/kaggle/working/stage11_auc_comparison.csv', index=False)
print("\n===== FULL COMPARISON TABLE =====")
print(results_df.to_string(index=False))
print("\nSaved: stage11_auc_comparison.csv")
print("\nIf Custom CNN's gap is larger than the pretrained models' gaps, the domain-gap")
print("hypothesis holds on a metric the class-weighting cannot distort, and Custom CNN's")
print("accuracy-level issue can be reported as a disclosed property, not a defect to fix.")


