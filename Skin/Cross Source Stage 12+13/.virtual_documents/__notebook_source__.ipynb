# ===== STAGE 13: MMD, BOTH DIRECTIONS (D-skin-1), per architecture — cleanup bug fixed =====
from tensorflow.keras.models import Model
import gc

def rbf_mmd2(X, Y, gamma=None):
    XY = np.vstack([X, Y])
    if gamma is None:
        from scipy.spatial.distance import pdist
        sq_dists = pdist(XY, 'sqeuclidean')
        median_dist = np.median(sq_dists)
        gamma = 1.0 / (2 * median_dist) if median_dist > 0 else 1.0

    def rbf_kernel_mean(A, B):
        total, count = 0.0, 0
        batch = 500
        for i in range(0, len(A), batch):
            Ai = A[i:i+batch]
            sq = np.sum(Ai**2, axis=1, keepdims=True) + np.sum(B**2, axis=1) - 2 * Ai @ B.T
            total += np.sum(np.exp(-gamma * np.maximum(sq, 0)))
            count += Ai.shape[0] * B.shape[0]
        return total / count

    Kxx = rbf_kernel_mean(X, X)
    Kyy = rbf_kernel_mean(Y, Y)
    Kxy = rbf_kernel_mean(X, Y)
    return Kxx + Kyy - 2 * Kxy

def get_penultimate_features(model, arch, test_df_split, prep_fn, sample_n=500, seed=42):
    sub = test_df_split.sample(n=min(sample_n, len(test_df_split)), random_state=seed)
    eval_idg = ImageDataGenerator(rescale=1./255) if prep_fn is None else ImageDataGenerator(preprocessing_function=prep_fn)
    gen = eval_idg.flow_from_dataframe(sub, x_col='image_path', y_col='label',
                                         target_size=(IMG_SIZE, IMG_SIZE), batch_size=BATCH_SIZE,
                                         class_mode='categorical', classes=FINAL_CLASSES, shuffle=False)
    if arch == 'custom':
        gap_layer = [l for l in model.layers if 'global_average_pooling' in l.name.lower()][0]
    else:
        gap_layer = model.layers[1]
    feat_model = Model(inputs=model.input, outputs=gap_layer.output)
    features = feat_model.predict(gen, verbose=0)
    del feat_model  # cleaned up HERE, inside the function's own scope, not in the caller
    return features

results = []
for arch in ['custom', 'mob', 'eff', 'res']:
    for train_src in ['isic', 'ham']:
        path = MODEL_PATHS_SS[(arch, train_src)]
        model = load_model(path)
        prep_fn = PREP_MAP[arch]

        feats_isic = get_penultimate_features(model, arch, i_te, prep_fn)
        feats_ham  = get_penultimate_features(model, arch, h_te, prep_fn)

        mmd2 = rbf_mmd2(feats_isic, feats_ham)
        results.append({'arch': DISPLAY[arch], 'through_model_trained_on': train_src,
                          'mmd_squared': mmd2, 'mmd': np.sqrt(max(mmd2, 0))})
        print(f"{DISPLAY[arch]:15} (features via {train_src}-trained model)  MMD(ISIC,HAM) = {np.sqrt(max(mmd2,0)):.4f}")

        del model; gc.collect(); tf.keras.backend.clear_session()

mmd_df = pd.DataFrame(results)
